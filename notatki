// GLUPIEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE
#define _POSIX_C_SOURCE 200809L

#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <errno.h>
#include <string.h>

int main(void)
{
    char* path = NULL;
    size_t path_size = 0;

    // 1. Uzytkownik wpisuje sciezke
    printf("Podaj sciezke: ");

    ssize_t n = getline(&path, &path_size, stdin);

    if (n == -1) {
        perror("getline");
        free(path);
        return 1;
    }

    // Usuwamy znak nowej linii
    if (n > 0 && path[n - 1] == '\n')
        path[n - 1] = '\0';

    // 2. Zmieniamy katalog roboczy
    if (chdir(path) == -1) {
        perror("chdir");
        free(path);
        return 1;
    }

    // 3. Dynamicznie alokujemy bufor
    size_t size = 128;
    char* buf = malloc(size);

    if (buf == NULL) {
        perror("malloc");
        free(path);
        return 1;
    }

    // 4. Pobieramy aktualna sciezke
    while (getcwd(buf, size) == NULL) {

        if (errno != ERANGE) {
            perror("getcwd");
            free(buf);
            free(path);
            return 1;
        }

        size *= 2;

        char* temp = realloc(buf, size);

        if (temp == NULL) {
            perror("realloc");
            free(buf);
            free(path);
            return 1;
        }

        buf = temp;
    }

    printf("Aktualny katalog: %s\n", buf);

    // 5. Zwalniamy pamiec
    free(buf);
    free(path);

    return 0;
}
