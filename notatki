// FSEEK

int fseek(FILE* stream, long offset, int whence); // 0 przy sukcesie

SEEK_SET - punktem odniesienia jest początek pliku, funkcja ustawia kursor pliku na offset - ym bajcie pliku.
SEEK_CUR - przesunięcie relatywne do obecnego kursora pliku, funkcja ustawia kursor o offset bajtów do przodu(do tyłu w przypadku wartości ujemnej).
SEEK_END - punktem odniesienia jest koniec pliku.Kursor pliku będzie wskazywał na dane tylko jeśli wartość offset jest ujemna.

// FTELL

long ftell(FILE* stream); // funkcja zwraca aktualną pozycje strumienia; przy bledzie -1L

#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>

int main(int argc, char* argv[])
{
    if (argc != 2) {
        fprintf(stderr, "Uzycie: %s PLIK\n", argv[0]);
        return EXIT_FAILURE;
    }

    // 1. Otwieramy plik
    FILE* plik = fopen(argv[1], "rb");

    if (plik == NULL) {
        perror("fopen");
        return EXIT_FAILURE;
    }

    // 2. Przechodzimy na koniec pliku
    if (fseek(plik, 0, SEEK_END) != 0) {
        perror("fseek");
        fclose(plik);
        return EXIT_FAILURE;
    }

    // 3. Sprawdzamy rozmiar
    long rozmiar = ftell(plik);

    if (rozmiar < 0) {
        perror("ftell");
        fclose(plik);
        return EXIT_FAILURE;
    }

    // 4. Alokujemy pamiec (+1 na '\0')
    if ((uintmax_t)rozmiar >= SIZE_MAX) {
        fprintf(stderr, "Plik jest za duzy\n");
        fclose(plik);
        return EXIT_FAILURE;
    }

    size_t n = (size_t)rozmiar;
    char* buf = malloc(n + 1);

    if (buf == NULL) {
        perror("malloc");
        fclose(plik);
        return EXIT_FAILURE;
    }

    // 5. Wracamy na poczatek
    if (fseek(plik, 0, SEEK_SET) != 0) {
        perror("fseek");
        free(buf);
        fclose(plik);
        return EXIT_FAILURE;
    }

    // 6. Odczytujemy caly plik
    size_t odczytane = fread(buf, 1, n, plik);

    if (odczytane != n) {
        fprintf(stderr, "Nie udalo sie odczytac calego pliku\n");
        free(buf);
        fclose(plik);
        return EXIT_FAILURE;
    }

    // 7. Dodajemy koniec napisu
    buf[odczytane] = '\0';

    // 8. Wypisujemy zawartosc
    printf("Rozmiar: %zu bajtow\n", n);
    printf("Zawartosc:\n%s\n", buf);

    // 9. Sprzatamy
    free(buf);

    if (fclose(plik) == EOF) {
        perror("fclose");
        return EXIT_FAILURE;
    }

    return EXIT_SUCCESS;
}

