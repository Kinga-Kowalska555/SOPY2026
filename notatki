#include <stdio.h>
#include <stdlib.h>

int main(void)
{
    FILE* plik = fopen("kot.txt", "rb");

    if (plik == NULL) {
        perror("fopen");
        return EXIT_FAILURE;
    }

    char buf[100];
    size_t n;

    while ((n = fread(buf, 1, sizeof(buf), plik)) > 0)
    {
        // Wypisujemy dokladnie tyle bajtow,
        // ile fread rzeczywiscie odczytalo.
        if (fwrite(buf, 1, n, stdout) != n) {
            perror("fwrite");
            fclose(plik);
            return EXIT_FAILURE;
        }
    }

    if (ferror(plik)) {
        perror("fread");
        fclose(plik);
        return EXIT_FAILURE;
    }

    if (fclose(plik) == EOF) {
        perror("fclose");
        return EXIT_FAILURE;
    }

    return EXIT_SUCCESS;
}

