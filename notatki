char* read_line(FILE * file)
{
    size_t capacity = 16;
    size_t length = 0;

    char* line = malloc(capacity);

    if (line == NULL)
    {
        ERR("malloc");
    }

    while (1)
    {
        if (capacity - length < 2)
        {
            capacity *= 2;

            char* tmp = realloc(line, capacity);

            if (tmp == NULL)
            {
                free(line);
                ERR("realloc");
            }

            line = tmp;
        }

        if (fgets(line + length, capacity - length, file) == NULL)
        {
            if (ferror(file))
            {
                free(line);
                ERR("fgets");
            }

            if (length == 0)
            {
                free(line);
                return NULL;
            }

            break;
        }

        length += strlen(line + length);

        if (length > 0 && line[length - 1] == '\n')
        {
            break;
        }
    }

    return line;
}

Po udanym odczycie getline() zwraca liczbę przeczytanych bajtów, zwykle wraz ze znakiem nowej linii \n, jeśli występował.
Natomiast - 1 oznacza, że wystąpił koniec pliku albo błąd odczytu.

