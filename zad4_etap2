#define _XOPEN_SOURCE 700

#include <dirent.h>
#include <errno.h>
#include <fcntl.h>
#include <ftw.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/uio.h>
#include <unistd.h>

#define LIBRARY_DIR "library"
#define INDEX_DIR "index"
#define BY_TITLE_DIR INDEX_DIR "/by-visible-title"
#define MAXFD 20

#define ERR(source) (perror(source), fprintf(stderr, "%s:%d\n", __FILE__, __LINE__), exit(EXIT_FAILURE))

// metadata of a single book; missing fields are NULL
typedef struct
{
    char* author;
    char* title;
    char* genre;
} book_t;

// join 2 path. returned pointer is for newly allocated memory and must be freed
char* join_paths(const char* path1, const char* path2)
{
    char* res;
    const int l1 = strlen(path1);
    if (path1[l1 - 1] == '/')
    {
        res = malloc(strlen(path1) + strlen(path2) + 1);
        if (!res)
            ERR("malloc");
        strcpy(res, path1);
    }
    else
    {
        res = malloc(strlen(path1) + strlen(path2) + 2);  // additional space for "/"
        if (!res)
            ERR("malloc");
        strcpy(res, path1);
        res[l1] = '/';
        res[l1 + 1] = 0;
    }
    return strcat(res, path2);
}

void usage(int argc, char** argv)
{
    (void)argc;
    fprintf(stderr, "USAGE: %s\n", argv[0]);
    exit(EXIT_FAILURE);
}

void free_book(book_t* book)
{
    free(book->author);
    free(book->title);
    free(book->genre);
    book->author = book->title = book->genre = NULL;
}

// replaces *field with a copy of value (later occurrences overwrite earlier ones)
static void set_field(char** field, const char* value)
{
    char* copy = strdup(value);
    if (!copy)
        ERR("strdup");
    free(*field);
    *field = copy;
}

// parses metadata file at path; returns 0 on success, -1 if file cannot be opened
int read_book(const char* path, book_t* book)
{
    FILE* f;
    char* line = NULL;
    size_t len = 0;
    ssize_t n;

    book->author = book->title = book->genre = NULL;

    if (!(f = fopen(path, "r")))
        return -1;

    errno = 0;
    while ((n = getline(&line, &len, f)) != -1)
    {
        if (n > 0 && line[n - 1] == '\n')
            line[--n] = '\0';
        if (n > 0 && line[n - 1] == '\r')
            line[--n] = '\0';

        char* sep = strchr(line, ':');
        if (!sep)  // not a key:value line (e.g. continuation of a multi-line value)
            continue;
        *sep = '\0';
        const char* key = line;
        const char* value = sep + 1;

        if (!strcmp(key, "author"))
            set_field(&book->author, value);
        else if (!strcmp(key, "title"))
            set_field(&book->title, value);
        else if (!strcmp(key, "genre"))
            set_field(&book->genre, value);
        errno = 0;
    }
    if (errno)
        ERR("getline");

    free(line);
    if (fclose(f))
        ERR("fclose");
    return 0;
}

void print_book(const book_t* book)
{
    printf("author: %s\n", book->author ? book->author : "missing!");
    printf("title: %s\n", book->title ? book->title : "missing!");
    printf("genre: %s\n", book->genre ? book->genre : "missing!");
}

// creates relative symlink BY_TITLE_DIR/<file name> pointing at each regular file
int index_by_title(const char* fpath, const struct stat* s, int type, struct FTW* f)
{
    (void)s;
    if (type != FTW_F)
        return 0;

    char* link_path = join_paths(BY_TITLE_DIR, fpath + f->base);
    // link lives two levels below program dir, so target goes up twice
    char* target = join_paths("../..", fpath);
    if (symlink(target, link_path))
    {
        if (errno == EEXIST)
        {
            fprintf(stderr, "duplicate visible title: %s\n", fpath + f->base);
            errno = EEXIST;  // fprintf may clobber errno
        }
        ERR("symlink");
    }
    free(target);
    free(link_path);
    return 0;
}

int main(int argc, char** argv)
{
    if (argc != 1)
        usage(argc, argv);

    if (mkdir(INDEX_DIR, 0755))
        ERR("mkdir " INDEX_DIR);
    if (mkdir(BY_TITLE_DIR, 0755))
        ERR("mkdir " BY_TITLE_DIR);

    if (nftw(LIBRARY_DIR, index_by_title, MAXFD, FTW_PHYS))
        ERR("nftw");
    return EXIT_SUCCESS;
}
