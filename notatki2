2. Odczytywanie opcji z terminala
Wariant A — za pomocą argc i argv
Przydatny, kiedy zadanie mówi, że program przyjmuje opcje a, b, c.

int main(int argc, char** argv)
{
    int a = 0, b = 0, c = 0;

    if (argc < 2 || argc > 4) {
        fprintf(stderr, "Niepoprawna liczba argumentow\n");
        return EXIT_FAILURE;
    }

    for (int i = 1; i < argc; i++)
    {
        if (strlen(argv[i]) != 1) {
            fprintf(stderr, "Niepoprawna opcja\n");
            return EXIT_FAILURE;
        }

        switch (argv[i][0])
        {
            case 'a':
                a = 1;
                break;
            case 'b':
                b = 1;
                break;
            case 'c':
                c = 1;
                break;
            default:
                fprintf(stderr, "Nieznana opcja\n");
                return EXIT_FAILURE;
        }
    }

    if (a)
        printf("Wybrano A\n");

    if (b)
        printf("Wybrano B\n");

    if (c)
        printf("Wybrano C\n");

    return EXIT_SUCCESS;
}



Uruchomienie:
./program a c


Otrzymasz:
Wybrano A
Wybrano C


W pamięci: argv przechowuje wskaźniki do argumentów, natomiast flagi a, b, c są zwykłymi zmiennymi int.
Wariant B — getopt() dla opcji z myślnikiem
Jeśli zadanie wymaga uruchamiania programu tak:
./program -a -c


wygodniej użyć getopt().

int main(int argc, char** argv)
{
    int a = 0, b = 0, c = 0;
    int opt;

    while ((opt = getopt(argc, argv, "abc")) != -1)
    {
        switch (opt)
        {
            case 'a':
                a = 1;
                break;
            case 'b':
                b = 1;
                break;
            case 'c':
                c = 1;
                break;
            default:
                fprintf(stderr, "Zla opcja\n");
                return EXIT_FAILURE;
        }
    }

    if (a) printf("A\n");
    if (b) printf("B\n");
    if (c) printf("C\n");

    return EXIT_SUCCESS;
}



getopt() obsługuje także zapis -abc.
Nie mieszaj tych wariantów: jeśli zadanie wymaga ./program a b, zastosuj argv jak w wariancie A.

3. Odczyt ścieżki z stdin i sprawdzanie katalogu
Ten szablon przyda Ci się praktycznie w każdym zadaniu systemowym.

void read_directory_path(char** result)
{
    char* path = NULL;
    size_t capacity = 0;

    ssize_t len = getline(&path, &capacity, stdin);

    if (len < 0) {
        free(path);
        ERR("getline");
    }

    if (len > 0 && path[len - 1] == '\n')
        path[len - 1] = '\0';

    struct stat st;

    if (stat(path, &st) < 0) {
        free(path);
        ERR("stat");
    }

    if (!S_ISDIR(st.st_mode)) {
        fprintf(stderr, "To nie jest katalog\n");
        free(path);
        exit(EXIT_FAILURE);
    }

    *result = path;
}



Przykład użycia w main():
int main(void)
{
    char* path = NULL;

    read_directory_path(&path);

    printf("Katalog: %s\n", path);

    free(path);
    return 0;
}


Dlaczego char** result?
Bo funkcja ma zmienić wskaźnik path znajdujący się w main().
Po powrocie z funkcji path wskazuje na zaalokowaną tablicę znaków. W main() trzeba później wykonać free(path).
W tym szablonie użyłam stat(), które podąża za dowiązaniami symbolicznymi. Jeśli w zadaniu trzeba badać sam obiekt dowiązania, zamień je na lstat().

4. Przeszukiwanie jednego katalogu — opendir() i readdir()
Jeżeli masz znaleźć katalogi zaczynające się od magazyn_, ale tylko bezpośrednio w podanym katalogu:

#define PREFIX "magazyn_"

void search_directory(const char* path)
{
    DIR* dirp;
    struct dirent* dp;
    struct stat st;

    if ((dirp = opendir(path)) == NULL)
        ERR("opendir");

    while (1)
    {
        errno = 0;
        dp = readdir(dirp);

        if (dp == NULL)
        {
            if (errno != 0)
                ERR("readdir");
            break;
        }

        if (strcmp(dp->d_name, ".") == 0 ||
            strcmp(dp->d_name, "..") == 0)
            continue;

        size_t len = strlen(path) + strlen(dp->d_name) + 2;
        char* fullpath = malloc(len);

        if (fullpath == NULL)
            ERR("malloc");

        snprintf(fullpath, len, "%s/%s", path, dp->d_name);

        if (lstat(fullpath, &st) < 0)
            ERR("lstat");

        if (S_ISDIR(st.st_mode))
        {
            if (strncmp(dp->d_name, PREFIX,
                        sizeof(PREFIX) - 1) == 0)
            {
                printf("Znaleziono: %s\n",
                       dp->d_name + sizeof(PREFIX) - 1);
            }
        }

        free(fullpath);
    }

    if (closedir(dirp) != 0)
        ERR("closedir");
}



Przykład:
search_directory("data");


Co zmieniasz w innym zadaniu? Przede wszystkim PREFIX, komunikat w printf() i ewentualnie S_ISDIR() na S_ISREG(), gdy interesują Cię zwykłe pliki.
W tym wariancie dynamicznie tworzymy pełną ścieżkę każdego wpisu. free(fullpath) zwalnia ją po sprawdzeniu.

5. Rekurencyjne przeszukiwanie katalogów bez nftw()
To bardzo ważny szablon. Funkcja wywołuje samą siebie dla każdego napotkanego podkatalogu.

#define PREFIX "punkt_"

void search_recursive(const char* path)
{
    DIR* dirp;
    struct dirent* dp;
    struct stat st;

    if ((dirp = opendir(path)) == NULL)
        ERR("opendir");

    while (1)
    {
        errno = 0;
        dp = readdir(dirp);

        if (dp == NULL)
        {
            if (errno != 0)
                ERR("readdir");
            break;
        }

        if (strcmp(dp->d_name, ".") == 0 ||
            strcmp(dp->d_name, "..") == 0)
            continue;

        // Tworzymy sciezke do znalezionego wpisu
        size_t len = strlen(path) + strlen(dp->d_name) + 2;

        char* fullpath = malloc(len);

        if (fullpath == NULL)
            ERR("malloc");

        snprintf(fullpath, len, "%s/%s", path, dp->d_name);

        if (lstat(fullpath, &st) < 0)
            ERR("lstat");

        if (S_ISDIR(st.st_mode))
        {
            if (strncmp(dp->d_name, PREFIX,
                        sizeof(PREFIX) - 1) == 0)
            {
                printf("Znaleziono: %s\n",
                       dp->d_name + sizeof(PREFIX) - 1);
            }

            // REKURENCJA
            search_recursive(fullpath);
        }

        free(fullpath);
    }

    if (closedir(dirp) != 0)
        ERR("closedir");
}



Wywołanie:
search_recursive("data");


Jak działa rekurencja w pamięci?
Przykładowo:
data/
└── magazyn_A/
    └── punkt_B/
        └── dokument.txt


Wywołania na stosie
search_recursive("data")
search_recursive("data/magazyn_A")
search_recursive("data/magazyn_A/punkt_B")
Brak kolejnych podkatalogów → powrót



Każde wywołanie funkcji ma własny dirp, dp, st oraz fullpath.
Dlaczego tu nie używamy chdir()? Korzystamy z pełnych ścieżek, więc każda funkcja może bezpiecznie wejść do podkatalogu bez zmieniania katalogu roboczego całego procesu.
Ten szablon celowo nie podąża za dowiązaniami symbolicznymi do katalogów, bo stosuje lstat() i S_ISDIR().

6. Rekurencyjne przeszukiwanie przez nftw()
To odpowiednik czwartego etapu Twojego zadania egzaminacyjnego.
Potrzebujesz dwóch funkcji: callbacku i funkcji uruchamiającej przeszukiwanie.

#define PREFIX "punkt_"

int walk(const char* path,
         const struct stat* st,
         int type,
         struct FTW* f)
{
    (void)st;

    if (type == FTW_D)
    {
        const char* name = path + f->base;

        if (strncmp(name, PREFIX,
                    sizeof(PREFIX) - 1) == 0)
        {
            const char* point =
                name + sizeof(PREFIX) - 1;

            printf("Punkt: %s\n", point);
            printf("Sciezka: %s\n", path);
        }
    }

    return 0;
}

void search_nftw(const char* path)
{
    if (nftw(path, walk, MAXFD, FTW_PHYS) != 0)
        ERR("nftw");
}



Wywołanie:
search_nftw("data");


nftw() automatycznie przekazuje do walk() informacje o kolejnych znalezionych obiektach.
W funkcji walk() możesz również wywołać inną funkcję, np. odczytującą plik z odnalezionego katalogu.
Ważna zasada: nie zwalniaj przez free() wskaźników path, st ani f otrzymanych w callbacku. Pamięcią zarządza nftw().

7. Odczyt pliku tekstowego linijka po linijce
Załóżmy, że plik pracownicy.txt zawiera:
Adam 25 4500
Kasia 30 6200
Piotr 22 3800


Chcemy przeczytać wszystkie wiersze, niezależnie od ich długości.

void read_lines(const char* filename)
{
    FILE* file = fopen(filename, "r");

    if (file == NULL)
        ERR("fopen");

    char* line = NULL;
    size_t capacity = 0;
    ssize_t len;

    while ((len = getline(&line, &capacity, file)) != -1)
    {
        if (len > 0 && line[len - 1] == '\n')
            line[len - 1] = '\0';

        printf("Wczytano: %s\n", line);

        // Tutaj mozesz parsowac dana linie
    }

    if (ferror(file))
        ERR("getline");

    free(line);

    if (fclose(file) != 0)
        ERR("fclose");
}



Użycie:
read_lines("pracownicy.txt");


Co warto zapamiętać:
- getline() automatycznie przydziela lub powiększa pamięć na bufor.
- Ten sam bufor line może być używany przy kolejnych odczytach.
- capacity zawiera rozmiar zaalokowanej pamięci.
- len to liczba odczytanych bajtów, bez końcowego '\0'.
- Po zakończeniu trzeba wykonać free(line).
Wariant: odczyt i parsowanie każdej linii
Jeśli chcesz odczytać imię, wiek i pensję:

void parse_workers(const char* filename)
{
    FILE* file = fopen(filename, "r");
    if (!file)
        ERR("fopen");

    char* line = NULL;
    size_t capacity = 0;

    while (getline(&line, &capacity, file) != -1)
    {
        char name[50];
        int age;
        int salary;

        int count = sscanf(line, "%49s %d %d",
                           name, &age, &salary);

        if (count == 3)
        {
            printf("Imie: %s\n", name);
            printf("Wiek: %d\n", age);
            printf("Pensja: %d\n", salary);
        }
    }

    if (ferror(file))
        ERR("getline");

    free(line);

    if (fclose(file))
        ERR("fclose");
}



Tutaj sscanf() odczytuje wartości z napisu w RAM, a nie bezpośrednio z pliku. getline() wcześniej przeniosło ten wiersz z pliku do pamięci.

8. Odczyt jednego pliku i zapis wyników do drugiego
To gotowy schemat na zadania, w których trzeba czytać i przekształcać dane.
Załóżmy, że liczby.txt zawiera:
10
20
30
40


Chcemy utworzyć wyniki.txt, gdzie każda liczba będzie pomnożona przez 2.

void transform_file(const char* input,
                    const char* output)
{
    FILE* in = fopen(input, "r");
    if (in == NULL)
        ERR("fopen input");

    FILE* out = fopen(output, "w");
    if (out == NULL) {
        fclose(in);
        ERR("fopen output");
    }

    char* line = NULL;
    size_t capacity = 0;

    while (getline(&line, &capacity, in) != -1)
    {
        int x;

        if (sscanf(line, "%d", &x) == 1)
        {
            if (fprintf(out, "%d\n", x * 2) < 0)
                ERR("fprintf");
        }
    }

    if (ferror(in))
        ERR("getline");

    free(line);

    if (fclose(in))
        ERR("fclose input");

    if (fclose(out))
        ERR("fclose output");
}



Użycie:
transform_file("liczby.txt", "wyniki.txt");


Otrzymasz:
20
40
60
80


Najważniejsze: fopen(output, "w") tworzy nowy plik albo nadpisuje istniejący.
Dlatego nie podawaj tego samego pliku jako wejścia i wyjścia — otwarcie go w trybie "w" usunęłoby jego dotychczasową zawartość.

