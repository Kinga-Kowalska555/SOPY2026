10. Dynamiczna tablica struktur — malloc() i fscanf()
Ten szablon nadaje się do zadań, w których na początku pliku znajduje się liczba elementów, a później ich dane.
Plik studenci.txt:
3
Adam 20 4
Kasia 21 5
Piotr 19 3



typedef struct {
    char name[50];
    int age;
    int grade;
} Student;

void read_students(const char* filename)
{
    FILE* f = fopen(filename, "r");
    if (f == NULL)
        ERR("fopen");

    size_t count;

    if (fscanf(f, "%zu", &count) != 1 || count == 0) {
        fprintf(stderr, "Niepoprawna liczba studentow\n");
        exit(EXIT_FAILURE);
    }

    if (count > SIZE_MAX / sizeof(Student)) {
        fprintf(stderr, "Za duzo studentow\n");
        exit(EXIT_FAILURE);
    }

    Student* students = malloc(count * sizeof(Student));

    if (students == NULL)
        ERR("malloc");

    for (size_t i = 0; i < count; i++)
    {
        if (fscanf(f, "%49s %d %d",
                   students[i].name,
                   &students[i].age,
                   &students[i].grade) != 3)
        {
            fprintf(stderr, "Blad danych\n");
            exit(EXIT_FAILURE);
        }
    }

    if (fclose(f))
        ERR("fclose");

    for (size_t i = 0; i < count; i++)
    {
        printf("%s: %d\n",
               students[i].name,
               students[i].grade);
    }

    free(students);
}



Najważniejsza linijka:
Student* students = malloc(count * sizeof(Student));


Przydzielamy na stercie miejsce na count struktur.
Dostęp do elementów:
students[i].name
students[i].age
students[i].grade


Wszystkie te struktury znajdują się w jednym, ciągłym bloku pamięci. Dlatego na końcu wystarczy jedno free(students).
W tym i kilku wcześniejszych krótkich szablonach błędy są obsługiwane przez natychmiastowe zakończenie programu. Jeśli zadanie wymaga zwolnienia wszystkich zasobów również przed wyjściem przy błędzie, dodaj wspólną sekcję sprzątającą.

11. Odczyt danych binarnych przez readv()
To jeden z najważniejszych szablonów do Twojego rodzaju laboratoriów.
Załóżmy, że plik binarny zawiera kolejno trzy wagi paczek i dwie wagi listów. Liczby elementów są znane przed wywołaniem funkcji.

typedef struct {
    size_t packages;
    size_t letters;

    unsigned long long* package_weights;
    unsigned long long* letter_weights;
} Shipment;

void read_binary(const char* filename,
                 size_t packages,
                 size_t letters)
{
    Shipment data = {0};

    data.packages = packages;
    data.letters = letters;

    if (packages == 0 || letters == 0)
        ERR("invalid counts");

    if (packages > SIZE_MAX / sizeof(unsigned long long) ||
        letters > SIZE_MAX / sizeof(unsigned long long))
        ERR("size overflow");

    data.package_weights =
        malloc(packages * sizeof(unsigned long long));

    data.letter_weights =
        malloc(letters * sizeof(unsigned long long));

    if (!data.package_weights || !data.letter_weights)
        ERR("malloc");

    struct iovec buffers[2];

    buffers[0].iov_base = data.package_weights;
    buffers[0].iov_len =
        packages * sizeof(unsigned long long);

    buffers[1].iov_base = data.letter_weights;
    buffers[1].iov_len =
        letters * sizeof(unsigned long long);

    int fd = open(filename, O_RDONLY);

    if (fd < 0)
        ERR("open");

    size_t expected =
        buffers[0].iov_len + buffers[1].iov_len;

    if (expected > (size_t)SSIZE_MAX)
        ERR("size too large");

    ssize_t bytes = readv(fd, buffers, 2);

    if (bytes < 0 || (size_t)bytes != expected)
        ERR("readv");

    if (close(fd))
        ERR("close");

    unsigned long long sum = 0;

    for (size_t i = 0; i < packages; i++)
        sum += data.package_weights[i];

    for (size_t i = 0; i < letters; i++)
        sum += data.letter_weights[i];

    printf("Suma: %llu\n", sum);

    free(data.package_weights);
    free(data.letter_weights);
}



Przykładowe wywołanie:
read_binary("3paczki_2listy", 3, 2);


Jak readv() rozdziela dane w pamięci
Plik binarny: 5 liczb × 8 bajtów100

