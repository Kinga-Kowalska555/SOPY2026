#define _XOPEN_SOURCE 700

#include <dirent.h>
#include <errno.h>
#include <fcntl.h>
#include <ftw.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/uio.h>
#include <unistd.h>

#define ERR(source) (perror(source), fprintf(stderr, "%s:%d\n", __FILE__, __LINE__), exit(EXIT_FAILURE))

// single database entry; title[64] is always 0 so title is a valid string
typedef struct
{
    unsigned int size;
    char title[65];
} db_entry_t;

// metadata of a single book; missing fields are NULL
typedef struct
{
    char* author;
    char* title;
    char* genre;
} book_t;

// join 2 path. returned pointer is for newly allocated memory and must be freed
char* join_paths(const char* path1, const char* path2)
{
    char* res;
    const int l1 = strlen(path1);
    if (path1[l1 - 1] == '/')
    {
        res = malloc(strlen(path1) + strlen(path2) + 1);
        if (!res)
            ERR("malloc");
        strcpy(res, path1);
    }
    else
    {
        res = malloc(strlen(path1) + strlen(path2) + 2);  // additional space for "/"
        if (!res)
            ERR("malloc");
        strcpy(res, path1);
        res[l1] = '/';
        res[l1 + 1] = 0;
    }
    return strcat(res, path2);
}

void usage(int argc, char** argv)
{
    (void)argc;
    fprintf(stderr, "USAGE: %s [database]\n", argv[0]);
    exit(EXIT_FAILURE);
}

void free_book(book_t* book)
{
    free(book->author);
    free(book->title);
    free(book->genre);
    book->author = book->title = book->genre = NULL;
}

// replaces *field with a copy of value (later occurrences overwrite earlier ones)
static void set_field(char** field, const char* value)
{
    char* copy = strdup(value);
    if (!copy)
        ERR("strdup");
    free(*field);
    *field = copy;
}

// parses metadata file at path; returns 0 on success, -1 if file cannot be opened
int read_book(const char* path, book_t* book)
{
    FILE* f;
    char* line = NULL;
    size_t len = 0;
    ssize_t n;

    book->author = book->title = book->genre = NULL;

    if (!(f = fopen(path, "r")))
        return -1;

    errno = 0;
    while ((n = getline(&line, &len, f)) != -1)
    {
        if (n > 0 && line[n - 1] == '\n')
            line[--n] = '\0';
        if (n > 0 && line[n - 1] == '\r')
            line[--n] = '\0';

        char* sep = strchr(line, ':');
        if (!sep)  // not a key:value line (e.g. continuation of a multi-line value)
            continue;
        *sep = '\0';
        const char* key = line;
        const char* value = sep + 1;

        if (!strcmp(key, "author"))
            set_field(&book->author, value);
        else if (!strcmp(key, "title"))
            set_field(&book->title, value);
        else if (!strcmp(key, "genre"))
            set_field(&book->genre, value);
        errno = 0;
    }
    if (errno)
        ERR("getline");

    free(line);
    if (fclose(f))
        ERR("fclose");
    return 0;
}

void print_book(const book_t* book)
{
    printf("author: %s\n", book->author ? book->author : "missing!");
    printf("title: %s\n", book->title ? book->title : "missing!");
    printf("genre: %s\n", book->genre ? book->genre : "missing!");
}

// makes a file name from metadata value: truncated to 64 bytes, '/' replaced with '_'.
// returns newly allocated string (must be freed) or NULL if value cannot be used as a name
char* make_name(const char* value)
{
    if (!value)
        return NULL;
    char* name = strndup(value, 64);
    if (!name)
        ERR("strndup");
    for (char* c = name; *c; c++)
        if (*c == '/')
            *c = '_';
    if (!strcmp(name, "") || !strcmp(name, ".") || !strcmp(name, ".."))
    {
        free(name);
        return NULL;
    }
    return name;
}

// creates symlink dir/name -> up/fpath; up must lead from dir back to program dir
void make_link(const char* dir, const char* name, const char* up, const char* fpath)
{
    char* link_path = join_paths(dir, name);
    char* target = join_paths(up, fpath);
    if (symlink(target, link_path))
    {
        if (errno == EEXIST)
        {
            fprintf(stderr, "duplicate entry: %s\n", link_path);
            errno = EEXIST;  // fprintf may clobber errno
        }
        ERR("symlink");
    }
    free(target);
    free(link_path);
}

// adds book to index/by-genre/<genre>/<title>; skipped if genre or title is missing
void index_by_genre(const char* fpath, const char* title, const char* genre_value)
{
    char* genre = make_name(genre_value);
    if (!title || !genre)
    {
        free(genre);
        return;
    }
    char* genre_dir = join_paths("index/by-genre", genre);
    if (mkdir(genre_dir, 0755) && errno != EEXIST)
        ERR("mkdir");
    make_link(genre_dir, title, "../../..", fpath);
    free(genre_dir);
    free(genre);
}

// nftw callback: indexes every regular file in the library
int index_book(const char* fpath, const struct stat* s, int type, struct FTW* f)
{
    (void)s;
    if (type != FTW_F)
        return 0;

    make_link("index/by-visible-title", fpath + f->base, "../..", fpath);

    book_t book;
    if (read_book(fpath, &book))
        ERR("fopen");
    char* title = make_name(book.title);
    if (title)
        make_link("index/by-title", title, "../..", fpath);
    index_by_genre(fpath, title, book.genre);
    free(title);
    free_book(&book);
    return 0;
}

// checks a single database entry against index/by-title
void check_entry(const db_entry_t* e)
{
    char* name = make_name(e->title);  // same transformation as when building by-title
    struct stat st;
    char* path = name ? join_paths("index/by-title", name) : NULL;

    if (!path || stat(path, &st))  // stat follows symlink to the book itself
    {
        if (path && errno != ENOENT)
            ERR("stat");
        printf("Book \"%s\" is missing\n", e->title);
    }
    else if ((off_t)e->size != st.st_size)
        printf("Book \"%s\" size mismatch (%u vs %lld)\n", e->title, e->size, (long long)st.st_size);

    free(path);
    free(name);
}

// reads database (entries of 4 byte size + 64 byte title) and checks every book
void check_database(const char* db_path)
{
    db_entry_t e;
    struct iovec iov[2] = {
        {.iov_base = &e.size, .iov_len = sizeof(e.size)},
        {.iov_base = e.title, .iov_len = 64},
    };
    const size_t entry_len = sizeof(e.size) + 64;
    struct stat st;
    int fd;

    if ((fd = open(db_path, O_RDONLY)) < 0)
        ERR("open");
    if (fstat(fd, &st))
        ERR("fstat");
    if (st.st_size % entry_len)
    {
        fprintf(stderr, "invalid database size: %lld\n", (long long)st.st_size);
        exit(EXIT_FAILURE);
    }

    e.title[64] = '\0';
    for (off_t i = 0; i < st.st_size / (off_t)entry_len; i++)
    {
        ssize_t n = readv(fd, iov, 2);
        if (n < 0)
            ERR("readv");
        if ((size_t)n != entry_len)
        {
            fprintf(stderr, "unexpected end of database\n");
            exit(EXIT_FAILURE);
        }
        check_entry(&e);
    }

    if (close(fd))
        ERR("close");
}

int main(int argc, char** argv)
{
    if (argc > 2)
        usage(argc, argv);

    if (mkdir("index", 0755))
        ERR("mkdir index");
    if (mkdir("index/by-visible-title", 0755))
        ERR("mkdir index/by-visible-title");
    if (mkdir("index/by-title", 0755))
        ERR("mkdir index/by-title");
    if (mkdir("index/by-genre", 0755))
        ERR("mkdir index/by-genre");

    if (nftw("library", index_book, 20, FTW_PHYS))
        ERR("nftw");

    if (argc == 2)
        check_database(argv[1]);
    return EXIT_SUCCESS;
}
